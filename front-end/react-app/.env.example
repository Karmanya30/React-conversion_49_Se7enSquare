# ==============================================================================
# Se7enSquare Frontend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your Google Cloud Console Client ID.
# Note: Vite requires environment variables exposed to the client to begin with VITE_

# Backend API Base URL
VITE_API_URL=http://localhost:3000/api

# Google OAuth 2.0 Web Client ID
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
