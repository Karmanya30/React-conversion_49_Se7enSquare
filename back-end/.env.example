# ==============================================================================
# Se7enSquare Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your real Google Cloud Console credentials.
# Do NOT commit your real .env file with secrets to version control.

# Server Port
PORT=3000

# Google OAuth 2.0 Web Client ID
# Create or obtain from: https://console.cloud.google.com/apis/credentials
# Must match the VITE_GOOGLE_CLIENT_ID configured in the frontend.
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Optional: Google OAuth Client Secret (used if server-side code exchange is enabled)
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
